{
	"folders": [
		{
			"name": "Root",
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/node_modules": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/bower_components": true,
			"**/*.code-search": true
		},
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/node_modules/**": true
		}
	},
	"extensions": {
		"recommendations": [
			"eamodio.gitlens",
			"mhutchie.git-graph",
			"github.vscode-pull-request-github"
		]
	}
}
